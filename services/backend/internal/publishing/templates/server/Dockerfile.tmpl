FROM {{ .BaseImage }}
USER 0
WORKDIR /app
COPY source/ /app/
# Install your dependencies here, for example:
# RUN {{ .PackageMount }}python -m pip install --no-cache-dir -r requirements.txt
RUN chgrp -R 0 /app && chmod -R g=u /app
ENV HOME=/tmp
USER 1001
EXPOSE {{ .Port }}
# Start command: set the startCommand template parameter in the profile, or edit this line.
CMD {{ json (list "sh" "-c" (default (printf "python %s" .EntryPoint) (index .Parameters "startCommand"))) }}
