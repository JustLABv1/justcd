# Local development. For a remote PostgreSQL server, use sslmode=verify-full
# and configure its TLS certificate/hostname accordingly.
JUSTCD_DATABASE_URL=postgres://justcd:change-me@localhost:5432/justcd?sslmode=disable

# Generate with: openssl rand -hex 32
# Keep this key stable and backed up; stored Git/Kubernetes/OIDC credentials
# cannot be decrypted if the key is lost or changed.
JUSTCD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# On a fresh database, create the first administrator at /signup.

JUSTCD_LISTEN_ADDRESS=:8080
JUSTCD_PUBLIC_URL=http://localhost:3000
JUSTCD_FRONTEND_URL=http://localhost:3000

# Local HTTP only. Set true behind HTTPS in production.
JUSTCD_COOKIE_SECURE=false
JUSTCD_SESSION_LIFETIME=12h
