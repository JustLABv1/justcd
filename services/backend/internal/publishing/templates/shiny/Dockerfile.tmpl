FROM {{ .BaseImage }}
USER 0
WORKDIR /app
COPY source/ /app/
{{- if .HasRenvLock }}
RUN R -e 'install.packages("renv", repos=Sys.getenv("R_REPOSITORY", "https://cloud.r-project.org")); renv::restore(prompt=FALSE)'
{{- else }}
RUN R -e 'p <- trimws(readLines("packages.txt")); p <- p[nzchar(p) & !startsWith(p, "#")]; install.packages(p, repos=Sys.getenv("R_REPOSITORY", "https://cloud.r-project.org")); stopifnot(all(p %in% rownames(installed.packages())))'
{{- end }}
RUN chgrp -R 0 /app && chmod -R g=u /app
ENV HOME=/tmp
USER 1001
EXPOSE {{ .Port }}
CMD {{ json (list "R" "-e" (printf "shiny::runApp('%s', host='0.0.0.0', port=%d)" .EntryPoint .Port)) }}
