# Docker Compose configuration. Copy to .env and replace both empty secrets.
# Generate each separately with: openssl rand -hex 32
# Use a hex password: it is safe to interpolate into the PostgreSQL URL.
JUSTCD_POSTGRES_PASSWORD=
JUSTCD_ENCRYPTION_KEY=

# Browser-facing origin; for a server, set https://justcd.example.com and
# JUSTCD_COOKIE_SECURE=true, then configure an HTTPS reverse proxy.
JUSTCD_PUBLIC_URL=http://localhost:3000
JUSTCD_COOKIE_SECURE=false

# Only the frontend is published. Defaults suit a reverse proxy on the host
# or an SSH tunnel. Change the bind address deliberately for direct access.
JUSTCD_BIND_ADDRESS=127.0.0.1
JUSTCD_PORT=3000

# Empty uses the moving frontend/backend tags. For reproducible deployments,
# set this to a published release suffix, e.g. -v0.1.0 (including the hyphen).
JUSTCD_IMAGE_TAG_SUFFIX=
JUSTCD_SESSION_LIFETIME=12h
