FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /justcd-agent ./cmd/agent
FROM alpine:3.24.2
RUN apk add --no-cache ca-certificates && addgroup -g 10001 agent && adduser -D -u 10001 -G agent agent
COPY --from=build /justcd-agent /usr/local/bin/justcd-agent
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/justcd-agent"]
